---
import { categoryHref } from '../lib/content.js'

const { categories, active = '' } = Astro.props
const home = import.meta.env.BASE_URL
const chips = [
  { id: '', label: 'همه', href: `${home}#products` },
  ...categories.map((cat) => ({
    id: cat.data.slug,
    label: cat.data.label,
    href: `${categoryHref(cat.data.slug)}#category-${cat.data.slug}`,
  })),
]
---
<div class="filter-scroll" id="products">
  <nav class="filter-bar" aria-label="فیلتر دسته‌بندی">
    {chips.map((chip) => (
      <a
        class:list={['filter-chip', { active: chip.id === active }]}
        id={chip.id ? `category-${chip.id}` : undefined}
        href={chip.href}
        aria-current={chip.id === active ? 'page' : undefined}
      >
        {chip.label}
      </a>
    ))}
  </nav>
</div>
