---
import { categoryHref } from '../lib/content.js'

const { categories, active = '' } = Astro.props
const home = import.meta.env.BASE_URL
const chip = (id, label, href) => ({ id, label, href, current: id === active })
const chips = [
  chip('', 'همه', `${home}#products`),
  ...categories.map((cat) => chip(cat.data.slug, cat.data.label, categoryHref(cat.data.slug))),
]
---
<div class="filter-scroll" id="products">
  <nav class="filter-bar" aria-label="فیلتر دسته‌بندی">
    {chips.map(({ id, label, href, current }) => (
      <a
        class:list={['filter-chip', { active: current }]}
        href={href}
        data-category={id}
        draggable="false"
        aria-current={current ? 'page' : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
</div>
<script>
  const wrap = document.querySelector('.filter-scroll')
  const bar = wrap.querySelector('.filter-bar')
  const grid = document.querySelector('.products')
  const overflow = () => bar.scrollWidth > bar.clientWidth
  const drag = { x: 0, scroll: 0, pressing: false, moved: false }

  const apply = (chip) => {
    const id = chip.dataset.category ?? ''
    for (const el of bar.querySelectorAll('.filter-chip')) {
      const on = el === chip
      el.classList.toggle('active', on)
      el.removeAttribute('aria-current')
      if (on) el.setAttribute('aria-current', 'page')
    }
    for (const card of grid.querySelectorAll('[data-category]')) {
      card.hidden = Boolean(id) && card.dataset.category !== id
    }
    chip.scrollIntoView({ inline: 'nearest', block: 'nearest' })
  }

  const sync = () => wrap.classList.toggle('is-scrollable', overflow())
  new ResizeObserver(sync).observe(bar)

  wrap.addEventListener('pointerdown', (event) => {
    if (event.button || event.pointerType === 'touch' || !overflow()) return
    Object.assign(drag, { x: event.clientX, scroll: bar.scrollLeft, pressing: true, moved: false })
  })

  addEventListener('pointermove', (event) => {
    if (!drag.pressing) return
    const dx = event.clientX - drag.x
    if (Math.abs(dx) <= 5) return
    if (!drag.moved) {
      drag.moved = true
      wrap.classList.add('is-dragging')
    }
    bar.scrollLeft = drag.scroll - dx
  })

  const eatClick = (event) => {
    event.preventDefault()
    event.stopImmediatePropagation()
    drag.moved = false
    removeEventListener('click', eatClick, true)
  }

  const endPress = () => {
    if (!drag.pressing) return
    drag.pressing = false
    wrap.classList.remove('is-dragging')
    if (drag.moved) addEventListener('click', eatClick, true)
  }
  addEventListener('pointerup', endPress)
  addEventListener('pointercancel', endPress)

  wrap.addEventListener('wheel', (event) => {
    if (!overflow() || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return
    bar.scrollLeft += document.documentElement.dir === 'rtl' ? -event.deltaY : event.deltaY
    event.preventDefault()
  }, { passive: false })

  bar.addEventListener('click', (event) => {
    const chip = event.target.closest('.filter-chip')
    if (!chip || drag.moved) return
    event.preventDefault()
    apply(chip)
    history.pushState(null, '', chip.href)
  })

  addEventListener('popstate', () => {
    const slug = location.pathname.match(/categories\/([^/]+)/)?.[1] ?? ''
    const chip = bar.querySelector(slug ? `[data-category="${slug}"]` : '[data-category=""]')
    if (chip) apply(chip)
  })

  requestAnimationFrame(() =>
    bar.querySelector('.filter-chip.active')?.scrollIntoView({ inline: 'nearest', block: 'nearest' })
  )
</script>
