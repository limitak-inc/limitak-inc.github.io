---
import { categoryHref } from '../lib/content.js'

const { categories, total, counts, active = '' } = Astro.props
const home = import.meta.env.BASE_URL
const chips = [
  { id: '', label: 'همه', n: total, href: home },
  ...categories.map((cat) => ({
    id: cat.id,
    label: cat.data.label,
    n: counts[cat.id] ?? 0,
    href: categoryHref(cat.id),
  })),
]
---
<div class="filter-scroll">
  <nav class="filter-bar" aria-label="فیلتر دسته‌بندی">
    {chips.map((chip) => (
      <a
        class:list={['filter-chip', { active: chip.id === active }]}
        href={chip.href}
        aria-label={`${chip.label}، ${chip.n} محصول`}
        aria-current={chip.id === active ? 'page' : undefined}
      >
        {chip.label}<span class="filter-n">{chip.n}</span>
      </a>
    ))}
  </nav>
</div>
