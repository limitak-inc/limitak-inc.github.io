---
import Picture from './Picture.astro'
import { dims } from '../lib/image.js'

const { href, title, imageSrc, slug, id } = Astro.props
const { w, h } = dims.card
---
<article class="card" data-category={slug ?? ''} data-product={id}>
  <a class="card-link" href={href}>
    <div class="card-media">
      <Picture src={imageSrc} alt={title} width={w} height={h} loading="lazy" />
    </div>
    <div class="card-body">
      <h2>{title}</h2>
    </div>
  </a>
</article>
