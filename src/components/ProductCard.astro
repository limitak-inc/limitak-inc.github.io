---
const { href, title, imageSrc, model, category } = Astro.props
---
<article class="card">
  <a class="card-link" href={href}>
    <div class="card-media">
      <img src={imageSrc} alt={title} loading="lazy" decoding="async" />
    </div>
    <div class="card-body">
      <h2>{title}</h2>
      {(category || model) && (
        <p class="card-meta">{[category, model].filter(Boolean).join(' · ')}</p>
      )}
    </div>
  </a>
</article>
