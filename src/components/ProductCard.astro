---
import { Image } from 'astro:assets'
import { asset } from '../lib/image.js'

const { id, href, title, image } = Astro.props
---
<article class="card">
  <a class="card-link" href={href}>
    <div class="card-media" style={`view-transition-name: product-${id}`}>
      <Image
        src={asset(image)}
        alt={title}
        width={640}
        format="webp"
        loading="lazy"
        draggable="false"
      />
    </div>
    <h2>{title}</h2>
  </a>
</article>
