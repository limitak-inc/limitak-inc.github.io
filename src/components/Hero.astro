---
const { hero } = Astro.props
const home = import.meta.env.BASE_URL
---
<section class="hero">
  <img class="hero-bg" src={hero.imageSrc} alt="" aria-hidden="true" loading="eager" decoding="async" />
  <div class="container hero-inner">
    <a class="hero-brand" href={home}>
      {hero.logoSrc && <img src={hero.logoSrc} alt="" />}
      <h1 class="hero-name">{hero.name}</h1>
    </a>
    <p class="hero-tagline">{hero.title}</p>
    <div class="hero-desc"><slot /></div>
  </div>
</section>
