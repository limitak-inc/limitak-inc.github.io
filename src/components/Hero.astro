---
import { Image } from 'astro:assets'
import { asset } from '../lib/image.js'

const { hero } = Astro.props
const home = import.meta.env.BASE_URL
---
<section class="hero">
  <Image
    class="hero-bg"
    src={asset(hero.image)}
    alt=""
    width={1280}
    format="webp"
    loading="eager"
    fetchpriority="high"
    draggable="false"
  />
  <div class="container hero-inner">
    <a class="hero-brand" href={home}>
      {hero.logo && (
        <Image src={asset(hero.logo)} alt={hero.name} format="webp" loading="eager" />
      )}
    </a>
    <h1 class="hero-tagline">{hero.title}</h1>
    <div class="hero-desc"><slot /></div>
  </div>
</section>
