---
import { webpPath, webpReady } from '../lib/image.js'

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  class: className,
  fetchpriority,
} = Astro.props

const webp = webpPath(src)
const modern = webpReady(src)
---
{modern ? (
  <picture>
    <source srcset={webp} type="image/webp" />
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class={className}
      fetchpriority={fetchpriority}
      draggable="false"
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class={className}
    fetchpriority={fetchpriority}
    draggable="false"
  />
)}
