---
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import { webpPath } from '../lib/image.js'

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  class: className,
  fetchpriority,
} = Astro.props

const publicPath = src.replace(import.meta.env.BASE_URL, '').replace(/^\//, '')
const webp = webpPath(src)
const hasWebp = existsSync(join(process.cwd(), 'public', publicPath.replace(/\.(jpe?g|png)$/i, '.webp')))
---
{hasWebp ? (
  <picture>
    <source srcset={webp} type="image/webp" />
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class={className}
      fetchpriority={fetchpriority}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class={className}
    fetchpriority={fetchpriority}
  />
)}
