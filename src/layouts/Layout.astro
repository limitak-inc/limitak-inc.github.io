---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { imageSrc } from '../lib/content.js'

const { title, description = '', company = {}, image } = Astro.props
const name = company.name ?? 'لیمیتک'
const logoFull = company.logoFull
const pageTitle = title ? `${title} | ${name}` : name
const ogImage = Astro.site && (image || logoFull)
  ? new URL(imageSrc(image || logoFull), Astro.site).href
  : undefined
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c1a22" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href={imageSrc('/logo-origin.png')} />
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link href="https://fonts.bunny.net/css?family=outfit:400,600,700|vazirmatn:400,600,700" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body class="site-shell">
    <a class="skip" href="#main">رفتن به محتوا</a>
    <main id="main" class="site-main">
      <slot />
    </main>
    <slot name="footer" />
    <ClientRouter />
  </body>
</html>
