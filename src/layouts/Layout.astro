---
import '../styles/global.css'
import { resolveTheme } from '../lib/content.js'
import { assetSrc, share } from '../lib/image.js'
import { resolveMeta } from '../lib/seo.js'

const {
  title,
  description = '',
  company = {},
  image,
  seo = {},
  siteSeo = {},
  social = {},
  theme: themeConfig = {},
  type = 'website',
  noindex = false,
} = Astro.props

const theme = resolveTheme(themeConfig)
const themeStyle = Object.entries(theme)
  .map(([key, value]) => value && `--color-${key}:${value}`)
  .filter(Boolean)
  .join(';')
const favicon = company.favicon || '/assets/logo-mono.png'
const meta = resolveMeta({
  title,
  description,
  image: await share(seo.image || image || siteSeo.image || company.logoFull),
  seo,
  siteSeo,
  company,
  site: Astro.site,
  canonicalPath: Astro.url.pathname,
})
const robots = meta.noindex || noindex ? 'noindex, nofollow' : 'index, follow'
---
<!doctype html>
<html lang="fa" dir="rtl" style={themeStyle || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.metaDescription} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={theme['bg-page'] || 'hsl(240 10% 14%)'} />
    <meta property="og:title" content={meta.metaTitle} />
    <meta property="og:description" content={meta.metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fa_IR" />
    {company.name && <meta property="og:site_name" content={company.name} />}
    {meta.canonical && <meta property="og:url" content={meta.canonical} />}
    {meta.canonical && <link rel="canonical" href={meta.canonical} />}
    {meta.ogImage && <meta property="og:image" content={meta.ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.metaTitle} />
    <meta name="twitter:description" content={meta.metaDescription} />
    {meta.ogImage && <meta name="twitter:image" content={meta.ogImage} />}
    {social.handle && <meta name="twitter:site" content={social.handle} />}
    <link rel="icon" href={assetSrc(favicon)} />
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link href="https://fonts.bunny.net/css?family=vazirmatn:400,600,700&display=swap" rel="stylesheet" />
    <title>{meta.metaTitle}</title>
    <slot name="head" />
  </head>
  <body class="site-shell">
    <a class="skip" href="#main">رفتن به محتوا</a>
    <main id="main" class="site-main">
      <slot />
    </main>
    <slot name="footer" />
    {import.meta.env.PROD && import.meta.env.PUBLIC_ANALYTICS && (
      <script defer src={import.meta.env.PUBLIC_ANALYTICS} data-domain={import.meta.env.PUBLIC_ANALYTICS_DOMAIN} />
    )}
  </body>
</html>
