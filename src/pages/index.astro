---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import ProductCard from '../components/ProductCard.astro'
import FilterBar from '../components/FilterBar.astro'
import Footer from '../components/Footer.astro'
import { getSite, getProducts, getCategories, imageSrc, productHref } from '../lib/content.js'
import { render } from 'astro:content'

const siteEntry = await getSite()
const [products, categories] = await Promise.all([getProducts(), getCategories()])
const { company, hero, social } = siteEntry.data
const { Content: HeroBody } = await render(siteEntry)
const description = (siteEntry.body ?? '').trim().slice(0, 160)
---
<Layout company={company} description={description} image={hero.image}>
  <Hero
    hero={{ title: hero.title, imageSrc: imageSrc(hero.image), eyebrow: company.name }}
  >
    <HeroBody />
  </Hero>
  <section class="products-section" id="products" aria-labelledby="products-title">
    <header class="container section-head">
      <h2 class="section-title" id="products-title">محصولات</h2>
      <p class="section-desc" data-product-count>{products.length} محصول</p>
    </header>
    <FilterBar categories={categories} total={products.length} />
    <div class="container products">
      {products.map((product) => (
        <ProductCard
          id={product.id}
          href={productHref(product.id)}
          title={product.data.title}
          imageSrc={imageSrc(product.data.image)}
          slug={product.data.category}
        />
      ))}
    </div>
  </section>
  <Footer slot="footer" company={company} social={social} />
</Layout>
