---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import { getSite, getProducts, getCategories, categoryLabel, imageSrc } from '../../lib/content.js'
import { render } from 'astro:content'

export const getStaticPaths = async () => {
  const products = await getProducts()
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }))
}

const { product } = Astro.props
const siteEntry = await getSite()
const categories = await getCategories()
const { company, social } = siteEntry.data
const { Content } = await render(product)
const home = import.meta.env.BASE_URL

const fields = [
  ['model', 'کد کالا'],
  ['category', 'دسته‌بندی'],
  ['material', 'جنس'],
  ['size', 'ابعاد'],
  ['pcs', 'تعداد در کارتن'],
]
---
<Layout title={product.data.title} company={company} image={product.data.image}>
  <div class="container product-page">
    <a class="back" href={`${home}#products`}>← بازگشت به کاتالوگ</a>
    <article class="product-detail">
    <img
      src={imageSrc(product.data.image)}
      alt={product.data.title}
      loading="eager"
      decoding="async"
      transition:name={`product-${product.id}`}
    />
    <div>
      <h1>{product.data.title}</h1>
      <dl>
        {fields.map(([key, label]) => {
          const val = product.data[key]
          if (val === undefined || val === '') return null
          const display = key === 'category' ? categoryLabel(categories, val) : String(val)
          return (
            <>
              <dt>{label}</dt>
              <dd>{display}</dd>
            </>
          )
        })}
        {product.data.tags?.length && (
          <>
            <dt>برچسب‌ها</dt>
            <dd class="tags">{product.data.tags.map((tag) => <span>{tag}</span>)}</dd>
          </>
        )}
      </dl>
      <div class="prose">
        <Content />
      </div>
    </div>
    </article>
  </div>
  <Footer slot="footer" company={company} social={social} />
</Layout>
