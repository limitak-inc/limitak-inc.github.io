---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import { getSite, getProducts, imageSrc } from '../../lib/content.js'
import { render } from 'astro:content'

export const getStaticPaths = async () => {
  const products = await getProducts()
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }))
}

const { product } = Astro.props
const siteEntry = await getSite()
const { company } = siteEntry.data
const { Content } = await render(product)
const home = import.meta.env.BASE_URL

const fields = [
  ['slug', 'شناسه'],
  ['model', 'کد کالا'],
  ['category', 'دسته‌بندی'],
  ['material', 'جنس'],
  ['size', 'ابعاد'],
  ['pcs', 'تعداد در کارتن'],
  ['order', 'ترتیب'],
]

const format = (key, val) =>
  key === 'tags' ? val.join('، ') : String(val)
---
<Layout title={product.data.title} company={company.name}>
  <div class="container product-page">
    <a class="back" href={home}>← بازگشت به کاتالوگ</a>
    <article class="product-detail">
    <img
      src={imageSrc(product.data.image)}
      alt={product.data.title}
      loading="eager"
      decoding="async"
    />
    <div>
      <h1>{product.data.title}</h1>
      <dl>
        {fields.map(([key, label]) => {
          const val = product.data[key]
          if (val === undefined || val === '') return null
          return (
            <>
              <dt>{label}</dt>
              <dd>{format(key, val)}</dd>
            </>
          )
        })}
        {product.data.tags?.length && (
          <>
            <dt>برچسب‌ها</dt>
            <dd class="tags">{product.data.tags.map((tag) => <span>{tag}</span>)}</dd>
          </>
        )}
      </dl>
      <div class="prose">
        <Content />
      </div>
    </div>
    </article>
  </div>
  <Footer slot="footer" company={company} />
</Layout>
