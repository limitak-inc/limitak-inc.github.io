---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import { getSite, getProducts, imageSrc } from '../../lib/content.js'
import { render } from 'astro:content'

export const getStaticPaths = async () => {
  const products = await getProducts()
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }))
}

const { product } = Astro.props
const siteEntry = await getSite()
const { company, footer } = siteEntry.data
const { Content } = await render(product)
const home = import.meta.env.BASE_URL
---
<Layout title={product.data.title} company={company.name}>
  <div class="container product-page">
    <a class="back" href={home}>← بازگشت به کاتالوگ</a>
    <article class="product-detail">
    <img
      src={imageSrc(product.data.image)}
      alt={product.data.title}
      loading="eager"
      decoding="async"
    />
    <div>
      <h1>{product.data.title}</h1>
      <dl>
        <dt>مدل</dt>
        <dd>{product.data.model}</dd>
        <dt>اندازه</dt>
        <dd>{product.data.size}</dd>
      </dl>
      <div class="prose">
        <Content />
      </div>
    </div>
    </article>
  </div>
  <Footer slot="footer" company={company} footer={footer} />
</Layout>
