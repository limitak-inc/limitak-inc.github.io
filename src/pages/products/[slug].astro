---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import { Image } from 'astro:assets'
import JsonLd from '../../components/JsonLd.astro'
import {
  getSite,
  getProducts,
  getCategories,
  categoryLabel,
  categoryHref,
  productHref,
} from '../../lib/content.js'
import { productDescription } from '../../lib/seo.js'
import { productSchema, breadcrumbSchema } from '../../lib/schema.js'
import { asset, share } from '../../lib/image.js'
import { render } from 'astro:content'

export const getStaticPaths = async () => {
  const products = await getProducts()
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }))
}

const { product } = Astro.props
const siteEntry = await getSite()
const categories = await getCategories()
const { company, social, theme, seo: siteSeo } = siteEntry.data
const { Content } = await render(product)
const home = import.meta.env.BASE_URL
const catSlug = product.data.category
const catName = categoryLabel(categories, catSlug)
const description = productDescription(product, catName)
const shareImage = await share(product.data.image)

const fields = [
  ['model', 'کد کالا'],
  ['material', 'جنس'],
  ['size', 'ابعاد'],
  ['pcs', 'تعداد در کارتن'],
]
const specs = fields
  .map(([key, label]) => [label, product.data[key]])
  .filter(([, value]) => value !== undefined && value !== '')

const crumbs = [
  { name: 'خانه', url: home },
  { name: catName, url: categoryHref(catSlug) },
  { name: product.data.title, url: productHref(product.id) },
]
---
<Layout
  title={product.data.title}
  description={description}
  company={company}
  image={product.data.image}
  seo={product.data.seo}
  siteSeo={siteSeo}
  social={social}
  theme={theme}
  type="product"
>
  <JsonLd slot="head" data={productSchema({
    site: Astro.site,
    product,
    image: shareImage,
    url: productHref(product.id),
    categoryLabel: catName,
    description,
    companyName: company.name,
  })} />
  <JsonLd slot="head" data={breadcrumbSchema({ site: Astro.site, items: crumbs })} />
  <div class="container product-page">
    <a class="back" href={categoryHref(catSlug)}>← بازگشت به کاتالوگ</a>
    <script>
      document.querySelector('.back')?.addEventListener('click', (event) => {
        if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        if (!globalThis.navigation?.canGoBack) return
        event.preventDefault()
        history.back()
      })
    </script>
    <article class="product-detail">
      <div class="product-media" style={`view-transition-name: product-${product.id}`}>
        <Image
          src={asset(product.data.image)}
          alt={product.data.title}
          width={1088}
          format="webp"
          loading="eager"
          fetchpriority="high"
          draggable="false"
        />
      </div>
      <div>
        <h1>{product.data.title}</h1>
        <dl>
          <dt>دسته‌بندی</dt>
          <dd><a href={categoryHref(catSlug)}>{catName}</a></dd>
          {specs.map(([label, value]) => (
            <>
              <dt>{label}</dt>
              <dd>{String(value)}</dd>
            </>
          ))}
          {product.data.tags?.length && (
            <>
              <dt>برچسب‌ها</dt>
              <dd class="tags">{product.data.tags.map((tag) => <span>{tag}</span>)}</dd>
            </>
          )}
        </dl>
        <div class="prose">
          <Content />
        </div>
      </div>
    </article>
  </div>
  <Footer slot="footer" company={company} social={social} />
</Layout>
