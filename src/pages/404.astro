---
import Layout from '../layouts/Layout.astro'
import Footer from '../components/Footer.astro'
import { getSite, getCategories } from '../lib/content.js'

const siteEntry = await getSite()
const categories = await getCategories()
const { company, social } = siteEntry.data
const home = import.meta.env.BASE_URL
---
<Layout title="یافت نشد" company={company} description="صفحه پیدا نشد" noindex>
  <div class="container product-page">
    <a class="back" href={home}>بازگشت به کاتالوگ</a>
    <h1 class="section-title">صفحه پیدا نشد</h1>
  </div>
  <Footer slot="footer" company={company} social={social} categories={categories} />
</Layout>
